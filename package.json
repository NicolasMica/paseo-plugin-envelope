{
  "name": "envelope",
  "version": "0.0.0",
  "private": true,
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "format": "oxfmt .",
    "format:files": "oxfmt",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.21.0"
  }
}
