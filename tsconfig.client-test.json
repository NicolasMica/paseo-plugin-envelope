{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.client-test.tsbuildinfo",
    "types": ["node", "react"]
  },
  "include": [
    "index.client.*",
    "client/**/*.ts",
    "client/**/*.tsx",
    "client/**/*.mts",
    "client/**/*.cts",
    "client/**/*.js",
    "client/**/*.jsx",
    "client/**/*.mjs",
    "client/**/*.cjs",
    "shared/**/*"
  ]
}
